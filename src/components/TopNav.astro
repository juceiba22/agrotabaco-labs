---
// src/components/TopNav.astro
---

<nav class="sticky top-0 z-50 backdrop-blur-md bg-book-bg/90 border-b border-[#d8cdb8] flex flex-col">
  <div class="px-6 py-4 flex justify-between items-center text-xs tracking-widest uppercase font-mono text-text-book-muted">
    <span>Tutorial Interactivo</span>
    <span class="font-serif italic text-sm normal-case text-accent-gold">Del Pucho a la App Tabar</span>
  </div>
  <!-- Barra de progreso -->
  <div class="h-[2px] bg-transparent w-full">
    <div id="scroll-progress" class="h-full bg-accent-gold w-0 transition-all duration-150 ease-out"></div>
  </div>
</nav>

<script>
  const updateProgress = () => {
    const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = (winScroll / height) * 100;
    const progressBar = document.getElementById("scroll-progress");
    if (progressBar) {
      progressBar.style.width = scrolled + "%";
    }
  };

  window.addEventListener("scroll", updateProgress);
  document.addEventListener('astro:page-load', () => {
    window.removeEventListener("scroll", updateProgress);
    window.addEventListener("scroll", updateProgress);
    updateProgress();
  });
</script>
