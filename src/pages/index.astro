---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/TopNav.astro';
import Header from '../components/Header.astro';
import Station from '../components/Station.astro';
import Footer from '../components/Footer.astro';

// Datos de las estaciones (sacados del esqueleto provisto por el usuario)
const stations = [
  {
    number: "01",
    problemTitle: "La soledad estructural del productor",
    problemDesc: "De cada $100 que paga el consumidor, el productor primario recibe solo <strong>$3 (el 3,2%)</strong>. 16.000 productores dispersos se enfrentan a solo 10 acopiadores que concentran el 90% del volumen, obligándolos a ser simples tomadores de precios.",
    problemQuote: "Asimetría de mercado crítica: 1.600 a 1.",
    solutionTitle: 'Módulo "Mi Tabaco" y Venta Colectiva',
    solutionDesc: "El panel permite digitalizar el stock físico en órdenes de venta con precios mínimos obligatorios y fundar <strong>\"Grupos de Venta Colectiva\"</strong> para unificar inventarios en bloque, equiparando el poder de negociación frente a la industria.",
    impact: "Rompe la compra fragmentada y protege el valor real del trabajo en la finca."
  },
  {
    number: "02",
    problemTitle: "La máquina de licuar el FET",
    problemDesc: "El FET se recauda en valor presente en el kiosco, pero se le paga al productor en pesos devaluados distribuidos en cuotas semestrales tardías. Mientras el fondo nominal se mantiene, <strong>el poder de compra real cayó un 55% entre 2017 y 2023</strong>.",
    problemQuote: "La inflación funciona como una transferencia silenciosa del productor al sistema.",
    solutionTitle: "Tokenización (TABAR) y Liquidez Inmediata",
    solutionDesc: "Al transformar los fardos curados en activos financieros digitales, los <strong>Dealers (Inversores)</strong> pueden inyectar liquidez inmediata de manera secundaria, eliminando la dependencia de los giros estatales burocráticos.",
    impact: "El productor cobra en valor presente y esquiva la devaluación inflacionaria."
  },
  {
    number: "03",
    problemTitle: "Las anomalías del contrabando",
    problemDesc: "Fronteras porosas permiten que el tabaco brasileño ingrese ilegalmente y sea declarado localmente (como ocurre en Misiones) para inflar los giros del FET de manera espuria, desvirtuando los datos reales de superficie y producción del país.",
    solutionTitle: "Carga de Warrants y Auditoría Atómica",
    solutionDesc: "Cada orden de financiamiento exige de forma estricta la carga de certificados físicos de <strong>Warrants legales</strong>, muestras fotográficas del lote y posición arancelaria. Todo se registra en un libro de logs inmutable para el Estado y los Administradores.",
    impact: "Bloquea el arbitraje ilegal transfronterizo y garantiza transparencia institucional."
  },
  {
    number: "04",
    problemTitle: "El nuevo lobby industrial",
    problemDesc: "La estrategia global de las multinacionales apunta al cigarrillo electrónico. Al ser un producto importado y \"sin hoja\", la apertura del vapeo prescindirá del productor tradicional, haciendo desaparecer el sentido del FET y la estructura agrícola histórica.",
    solutionTitle: "Independencia y Gobernanza Autónoma",
    solutionDesc: "La app prepara al sector para la desconexión industrial. Al automatizar contratos legales en PDF mediante <code>jspdf</code> y asentar la gobernanza por roles, el ecosistema productivo adquiere capacidades financieras autónomas e inmunidad regulatoria.",
    impact: "Si el marco legal tradicional se destruye, el productor ya cuenta con su propia red de subsistencia digital."
  }
];
---

<Layout title="TABAR: El Tutorial Guiado | Del Pucho a la App">
  <TopNav />
  
  <main>
    <Header />
    
    <div class="stations-container">
      {stations.map(station => (
        <Station 
          number={station.number}
          problemTitle={station.problemTitle}
          problemDesc={station.problemDesc}
          problemQuote={station.problemQuote}
          solutionTitle={station.solutionTitle}
          solutionDesc={station.solutionDesc}
          impact={station.impact}
        />
      ))}
    </div>
  </main>
  
  <Footer />
</Layout>
